# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key (required for all AI agents)
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Convex configuration (optional persistence)
VITE_CONVEX_URL=your-convex-deployment-url-here

# Sentry configuration (optional error monitoring)
VITE_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# ─────────────────────────────────────────────────────────────────────────────
# AI Agent System — Public Adjuster
# ─────────────────────────────────────────────────────────────────────────────

# ── ClaimWizard CRM ───────────────────────────────────────────────────────────
# Base URL for your ClaimWizard account (no trailing slash)
CLAIMWIZARD_BASE_URL=https://app.claimwizard.com
# Preferred: API key from ClaimWizard account settings
CLAIMWIZARD_API_KEY=your-claimwizard-api-key-here
# Fallback: username/password if no API key
CLAIMWIZARD_USERNAME=your-claimwizard-username-here
CLAIMWIZARD_PASSWORD=your-claimwizard-password-here

# ── Google APIs (Calendar + Gmail) ────────────────────────────────────────────
# Create OAuth2 credentials at https://console.cloud.google.com/
# Required scopes: calendar, gmail.modify, gmail.send
GOOGLE_CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth2-client-secret
# Refresh token from one-time OAuth2 consent flow
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
# Calendar ID to use (default: primary)
GOOGLE_CALENDAR_ID=primary
# Gmail address to send/read from
GOOGLE_USER_EMAIL=you@yourfirm.com

# ── Weather Data ──────────────────────────────────────────────────────────────
# NOAA CDO API token (optional — increases rate limits)
# Get free token at: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=your-noaa-token-here
# HailTrace API key (optional — enables hail size data)
# Contact HailTrace at www.hailtrace.com for API access
HAILTRACE_API_KEY=your-hailtrace-api-key-here